{
  "name": "dialectica",
  "display_name": "Dialectica",
  "version": "0.1.0",
  "type": "core",
  "interface": "cdylib",
  "category": "general",
  "description": "Dialectica core — a decentralized forum on the Logos stack",
  "main": "dialectica_plugin",
  "dependencies": ["delivery_module"],
  "concurrency": "single",

  "dependency_overrides": {
    "delivery_module": {
      "file": "contracts/delivery_module.lidl"
    }
  },

  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "DialecticaModule"
    }
  },

  "nix": {
    "packages": {
      "build": [],
      "runtime": []
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
